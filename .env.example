# Copy to .env and fill in — never commit .env

# Housecall Pro (MAX/XL plan required for API)
# HCP_API_KEY=

# Intuit QuickBooks OAuth (API sync + MCP)
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REALM_ID=
# QBO_REFRESH_TOKEN=
# QBO_ENVIRONMENT=production

# Command Center login (also set as GitHub Actions secret)
# NGC_COMMAND_CENTER_PASSWORD=

# Morning briefing email (GitHub Actions secrets — never commit)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=Ryan@NGCgolfcarts.com
# SMTP_PASSWORD=
# SMTP_FROM=Ryan@NGCgolfcarts.com
# BRIEFING_EMAIL_TO=Ryan@NGCgolfcarts.com

# Optional: Zapier webhook URLs for no-code automations
# ZAPIER_HCP_JOB_COMPLETED=
# ZAPIER_WEEKLY_REVIEW_REMINDER=

# GarageBuddy local eval (see scripts/garagebuddy/env.example)
# GARAGEBUDDY_SA_PASSWORD=
# GARAGEBUDDY_SQL_PORT=1433
