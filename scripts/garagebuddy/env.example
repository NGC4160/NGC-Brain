# Copy to scripts/garagebuddy/.env (gitignored) or export before setup.
# Never commit real passwords.

# SQL Server SA password (must meet SQL Server complexity rules)
GARAGEBUDDY_SA_PASSWORD=ChangeMe_StrongPass123!

# Host port for SQL Server
GARAGEBUDDY_SQL_PORT=1433

# Optional: override clone location (default: tools/GarageBuddy)
# GARAGEBUDDY_ROOT=
