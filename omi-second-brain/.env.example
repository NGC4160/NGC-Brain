# =============================================================================
# Omi Second Brain — environment variables
# Copy to .env and fill in. Never commit .env.
# =============================================================================

# --- Omi keys (TWO different keys) ---
# Developer API (omi_dev_...) — batch ingest via REST
# Create: Omi app → Settings → Developer → Create Key (scopes: conversations, memories, action-items)
OMI_DEV_API_KEY=omi_dev_REPLACE_ME

# MCP key (omi_mcp_...) — Claude Desktop / Cursor MCP SSE
# Create: Omi app → Settings → Developer → MCP
OMI_MCP_API_KEY=omi_mcp_REPLACE_ME

# Omi API base (override only for self-hosted)
OMI_API_BASE=https://api.omi.me/v1/dev

# --- Obsidian vault (absolute path recommended) ---
# macOS example: /Users/you/Documents/Obsidian/SecondBrain
# Linux example: /home/you/Documents/Obsidian/SecondBrain
OBSIDIAN_VAULT_PATH=

# --- Local AI (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Set true to skip cloud LLMs entirely (summaries via Ollama only)
LOCAL_ONLY=true

# Optional cloud fallback for summarization (leave empty for local-only)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Vector index ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=omi_second_brain

# --- Ingest behavior ---
# Pull conversations finished after this many hours (default: 36)
INGEST_LOOKBACK_HOURS=36
# Write full transcripts under Daily/Conversations/ (true/false)
INGEST_SAVE_TRANSCRIPTS=true
# Also write action items to Inbox/Tasks/
INGEST_EXTRACT_TASKS=true

# --- Calendar (optional ICS export for tasks) ---
# CALENDAR_ICS_PATH=./data/omi_tasks.ics
