{
  "mcpServers": {
    "omi": {
      "url": "https://api.omi.me/v1/mcp/sse",
      "headers": {
        "Authorization": "Bearer REPLACE_WITH_omi_mcp_KEY"
      }
    },
    "obsidian-vault": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/YOU/Documents/Obsidian/SecondBrain"
      ]
    },
    "second-brain-local": {
      "command": "python",
      "args": ["servers/second_brain_server/server.py"],
      "cwd": "/Users/YOU/path/to/omi-second-brain",
      "env": {
        "OMI_DEV_API_KEY": "omi_dev_REPLACE_ME",
        "OBSIDIAN_VAULT_PATH": "/Users/YOU/Documents/Obsidian/SecondBrain",
        "CHROMA_PERSIST_DIR": "/Users/YOU/path/to/omi-second-brain/data/chroma",
        "OLLAMA_BASE_URL": "http://localhost:11434",
        "OLLAMA_EMBED_MODEL": "nomic-embed-text",
        "PYTHONPATH": "/Users/YOU/path/to/omi-second-brain/src"
      }
    }
  }
}
