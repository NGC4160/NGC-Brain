<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd agent — nightly Omi → Obsidian ingest + embed + reflect.

  Install:
    1. Edit paths below (PROJECT_ROOT, Python, vault via .env).
    2. ./scripts/scheduler/install_launchd.sh
  Logs: ~/Library/Logs/omi-second-brain/
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.omi-second-brain.ingest</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/YOU/path/to/omi-second-brain/scripts/scheduler/nightly_run.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>23</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/YOU/path/to/omi-second-brain</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/omi-second-brain/ingest.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/omi-second-brain/ingest.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
